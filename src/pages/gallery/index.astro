---
import SanityRichTextImageBlock from "../../components/SanityRichTextImageBlock.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { sanityClient } from "sanity:client";

export async function getStaticPaths() {
  return await sanityClient.fetch(`*[_type == "galleryImage"]`);
}

const images = await getStaticPaths();

console.log(images);
console.log(images[0].mainImage.asset);
---

<BaseLayout title="Gallery">
  <main class="prose px-12 py-6">
    <h1>Gallery</h1>
    <div class="container mx-auto gap-4 flex-wrap">
      {
        images.map((image: any) => {
          return <SanityRichTextImageBlock asset={image.mainImage} />;
        })
      }
    </div>
  </main>
</BaseLayout>
